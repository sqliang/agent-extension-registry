{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sqliang/agent-extension-registry/schemas/component.schema.json",
  "title": "Agent Extension Component",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "kind", "version", "status", "description", "entry", "invocation", "targets"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "kind": { "enum": ["skill", "agent", "hook", "mcp"] },
    "version": { "type": "string" },
    "status": { "enum": ["experimental", "beta", "stable", "deprecated"] },
    "description": { "type": "string", "minLength": 1 },
    "entry": { "type": "string", "minLength": 1 },
    "invocation": { "enum": ["automatic", "explicit"] },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["codex", "claude", "cursor"] }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "components": { "type": "array", "items": { "$ref": "#/$defs/reference" } },
        "external": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command", "required", "description"],
            "properties": {
              "command": { "type": "string", "minLength": 1 },
              "required": { "type": "boolean" },
              "description": { "type": "string", "minLength": 1 },
              "install": { "type": "object" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "version": { "type": "string", "minLength": 1 },
        "optional": { "type": "boolean" }
      }
    }
  }
}
